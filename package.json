{
  "name": "winkpop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "WinKPop — the photocard-native marketplace for K-pop collectors. One codebase for iOS, Android, and Web.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e:web": "playwright test --config e2e/web/playwright.config.ts",
    "test:e2e:native": "maestro test e2e/native/flows",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.24",
    "expo-asset": "~56.0.25",
    "expo-constants": "~56.0.27",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.19",
    "expo-modules-core": "~56.0.27",
    "expo-router": "~56.2.22",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^1.76.0",
    "nativewind": "^4.1.23",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.6",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
